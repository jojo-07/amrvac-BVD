&testlist
 /

 &filelist
        autoconvert   = .true.
        saveprim      = .true.
        base_filename ='icarus_paper_v3'
        convert_type  = 'vtuBCCmpi'
        slice_type    = 'csv'
        nocartesian   = .true.
        nwauxio       = 3
/

 &savelist
        dtsave_log=1.d-3
        itsave(1,1)   = 0
        itsave(1,2)   = 0
        tsavestart(2) = 24.0
        dtsave_dat    = 24.0
/


 &stoplist
        time_max      = 720.0d0
 /

 &methodlist
        time_stepper      = 'twostep'
        flux_scheme       = 20*'tvdlf'
        limiter           = 20*'minmod'
        dimsplit          = .false.
        check_small_values = .false.
        small_pressure    = 1.0d-18
        small_density     = 1.0d-14
        small_values_method = 'replace'
        small_values_daverage = 8
 /


 &mhd_list
       typedivbfix = 'linde'
       divbdiff = 0.9
       mhd_rotating_frame = .true.
       mhd_n_tracer = 1
       SI_unit = .false.
        mhd_particles = .false.
 /

 &particles_list
       physics_type_particles='none'
 /

 &boundlist
        typeboundary_min1 = 'bc_icarus', 'bc_icarus', 'asymm', 'asymm', 'bc_icarus', 'bc_icarus', 'asymm', 'asymm'
        typeboundary_max1 =8*'cont'
        typeboundary_min2 =8*'symm'
        typeboundary_max2 =8*'symm'
        typeboundary_min3 =8*'periodic'
        typeboundary_max3 =8*'periodic'
        save_physical_boundary = .true.
 /

 &meshlist
        stretch_dim(1)     = 'uni'
        qstretch_baselevel = 1.010
        stretch_uncentered  = .false.
        refine_criterion=1
        refine_max_level = 2
        nbufferx1=0
        nbufferx2=0
        nbufferx3=0
        block_nx1=10
        block_nx2=8
        block_nx3=12
        domain_nx1= 100
        domain_nx2= 32
        domain_nx3= 96
        xprobmin1=21.5
        xprobmax1=432.5
        xprobmin2=8.14606741573d-2
        xprobmax2=4.18539325843d-1
        xprobmin3=0.0d0
        xprobmax3=1.0d0
 /


 &paramlist
        typecourant='maxsum'
        courantpar=0.9d0
        slowsteps=10
/

&rotating_frame_list
        omega_frame= 0.010692d0
/
&bd_list
        boundary_data_file_name="paper_testcase_innerBCs.vtk"
        interp_phy_first_row=.false.
        boundary_data_primitive=.true.
/

&icarus_list
        amr_criterion = 'shock'
        cme_flag =1
        num_cmes = 5
        relaxation = 8
        cme_insertion = 7
        cme_parameter_file = 'cme_euhforia_formatted.in'
        magnetogram_time = '2015-06-25T01:04:00'
        delta_phi = -1.2040994899278814 
/